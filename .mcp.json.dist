{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@0.0.78",
        "--headless",
        "--isolated",
        "--browser", "chromium",
        "--executable-path", "/path/to/ms-playwright/chromium-<version>/chrome-linux64/chrome",
        "--viewport-size", "900x1200",
        "--allowed-origins", "https://dev.example.adam.co.za",
        "--output-dir", "/tmp/adam-docs-capture"
      ]
    }
  }
}
